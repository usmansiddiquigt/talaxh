    {
      "name": "Conversations & Messages",
      "description": "`public.conversations` and `public.messages`. RLS: participants can SELECT messages; the BEFORE INSERT trigger sets `moderation_status` based on `blocked_keywords` matches; recipients only see `approved` messages.",
      "item": [
        {
          "name": "List My Conversations",
          "request": {
            "method": "GET",
            "header": [{ "key": "apikey", "value": "{{anon_key}}" }],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/conversations?or=(buyer_id.eq.{{user_id}},seller_id.eq.{{user_id}})&select=*&order=created_at.desc",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "conversations"],
              "query": [
                { "key": "or",     "value": "(buyer_id.eq.{{user_id}},seller_id.eq.{{user_id}})" },
                { "key": "select", "value": "*" },
                { "key": "order",  "value": "created_at.desc" }
              ]
            }
          }
        },
        {
          "name": "Create Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey",       "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer",       "value": "return=representation" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"listing_id\": \"SOME-UUID\",\n  \"buyer_id\": \"{{user_id}}\",\n  \"seller_id\": \"SELLER-UUID\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/conversations",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "conversations"]
            }
          }
        },
        {
          "name": "List Messages In Conversation",
          "request": {
            "method": "GET",
            "header": [{ "key": "apikey", "value": "{{anon_key}}" }],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/messages?conversation_id=eq.SOME-UUID&select=*&order=created_at.asc",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "messages"],
              "query": [
                { "key": "conversation_id", "value": "eq.SOME-UUID" },
                { "key": "select",          "value": "*" },
                { "key": "order",           "value": "created_at.asc" }
              ]
            },
            "description": "Senders see all their own messages (any moderation_status). Recipients only see `moderation_status='approved'`."
          }
        },
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey",       "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer",       "value": "return=representation" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"conversation_id\": \"SOME-UUID\",\n  \"sender_id\": \"{{user_id}}\",\n  \"body\": \"Is this still available?\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/messages",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "messages"]
            },
            "description": "BEFORE INSERT trigger scans the body. Match → moderation_status='under_review' and the recipient won't see it until an admin approves."
          }
        },
        {
          "name": "Mark Messages Delivered",
          "request": {
            "method": "PATCH",
