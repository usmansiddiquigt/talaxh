              "raw": "{{supabase_url}}/rest/v1/listings?moderation_status=eq.pending&select=*&order=created_at.desc",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "listings"],
              "query": [
                { "key": "moderation_status", "value": "eq.pending" },
                { "key": "select",            "value": "*" },
                { "key": "order",             "value": "created_at.desc" }
