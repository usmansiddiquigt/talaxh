    {
      "name": "Notifications",
      "description": "`public.notifications`. Users can only SELECT their own. Inserts are done by DB triggers — the client never POSTs here.",
      "item": [
        {
          "name": "List Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "apikey", "value": "{{anon_key}}" }],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/notifications?user_id=eq.{{user_id}}&select=*&order=created_at.desc&limit=100",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "notifications"],
              "query": [
                { "key": "user_id", "value": "eq.{{user_id}}" },
                { "key": "select",  "value": "*" },
                { "key": "order",   "value": "created_at.desc" },
                { "key": "limit",   "value": "100" }
              ]
            }
          }
        },
        {
          "name": "Unread Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "apikey", "value": "{{anon_key}}" },
              { "key": "Prefer", "value": "count=exact" }
            ],
            "url": {
              "raw": "{{supabase_url}}/rest/v1/notifications?user_id=eq.{{user_id}}&is_read=eq.false&select=id",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "notifications"],
              "query": [
                { "key": "user_id", "value": "eq.{{user_id}}" },
                { "key": "is_read", "value": "eq.false" },
                { "key": "select",  "value": "id" }
              ]
            },
            "description": "The count comes back in the `Content-Range` response header (e.g. `0-99/27` means 27 unread)."
          }
        },
        {
          "name": "Mark Notification Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey",       "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"is_read\": true,\n  \"read_at\": \"2026-06-06T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/notifications?id=eq.SOME-UUID&user_id=eq.{{user_id}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "notifications"],
              "query": [
                { "key": "id",      "value": "eq.SOME-UUID" },
                { "key": "user_id", "value": "eq.{{user_id}}" }
              ]
            }
          }
        },
        {
          "name": "Mark All Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "apikey",       "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"is_read\": true,\n  \"read_at\": \"2026-06-06T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{supabase_url}}/rest/v1/notifications?user_id=eq.{{user_id}}&is_read=eq.false",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "notifications"],
              "query": [
                { "key": "user_id", "value": "eq.{{user_id}}" },
                { "key": "is_read", "value": "eq.false" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Storage – listing-photos",
      "description": "Supabase Storage. Anyone can GET (the bucket is public); authenticated users can write into `${uid}/...`; admins can delete anything.",
      "item": [
        {
          "name": "Upload Photo (binary)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey",       "value": "{{anon_key}}" },
              { "key": "Content-Type", "value": "image/jpeg" },
              { "key": "x-upsert",     "value": "false" }
            ],
            "body": {
              "mode": "file",
              "file": { "src": "/path/to/local/photo.jpg" }
            },
            "url": {
              "raw": "{{supabase_url}}/storage/v1/object/listing-photos/{{user_id}}/UNIQUE-FILENAME.jpg",
              "host": ["{{supabase_url}}"],
              "path": ["storage", "v1", "object", "listing-photos", "{{user_id}}", "UNIQUE-FILENAME.jpg"]
            },
            "description": "Path MUST start with `{{user_id}}/` to satisfy the storage policy 'Listing photos: users upload to own folder'. Pick the body file in the Body tab → File → Select File."
          }
        },
        {
          "name": "Get Public URL (no auth needed)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/storage/v1/object/public/listing-photos/{{user_id}}/UNIQUE-FILENAME.jpg",
              "host": ["{{supabase_url}}"],
              "path": ["storage", "v1", "object", "public", "listing-photos", "{{user_id}}", "UNIQUE-FILENAME.jpg"]
            },
            "description": "Public CDN URL — the same one stored in `listings.photos`. No `apikey` or `Authorization` required."
          }
        },
        {
          "name": "Delete Photo",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "apikey", "value": "{{anon_key}}" }],
            "url": {
              "raw": "{{supabase_url}}/storage/v1/object/listing-photos/{{user_id}}/UNIQUE-FILENAME.jpg",
              "host": ["{{supabase_url}}"],
              "path": ["storage", "v1", "object", "listing-photos", "{{user_id}}", "UNIQUE-FILENAME.jpg"]
            },
            "description": "Allowed if the path is under your own folder, or you're an admin."
          }
        }
      ]
    },
    {
      "name": "Admin – Listings Moderation",
      "description": "Requires the bearer token to belong to a user with `profiles.is_admin = true`.",
      "item": [
        {
